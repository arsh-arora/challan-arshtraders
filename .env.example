# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Public app URL used for OAuth redirects.
# Use the exact deployed origin in production, for example https://challan.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal access control.
# In production, AUTH_REQUIRE_ALLOWLIST defaults to true unless explicitly set false.
AUTH_ALLOWED_EMAILS=owner@example.com,user@example.com
AUTH_ALLOWED_DOMAINS=
AUTH_REQUIRE_ALLOWLIST=true

# Business profile used on documents and exports.
# This tool is built for internal Arsh Traders usage; keep these fixed unless
# the business details legally change.
BUSINESS_NAME=Arsh Traders
BUSINESS_ADDRESS=Plot No. 119-2A, Saket Nagar, Bhopal - 462024 (M.P.)
BUSINESS_GSTIN=23AECPC0996H2ZR
BUSINESS_EMAIL=director@arshtraders.com
BUSINESS_WEBSITE=arshtraders.com
BUSINESS_LOGO_FILE=horizontal-logo.png

# Inventory location naming.
WAREHOUSE_LOCATION_NAME=Arsh Traders
COMPANY_LOCATION_PREFIX=Company:

# Document and ticket numbering.
DOC_INBOUND_PREFIX=IN
DOC_DEFAULT_PREFIX=DOC
TICKET_PREFIX=TKT
TICKET_SEQUENCE_WIDTH=4
